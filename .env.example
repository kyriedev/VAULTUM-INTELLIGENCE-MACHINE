# =========================
# WEB
# =========================
# Frontend runtime
VITE_APP_TITLE=VAULTUM AI
VITE_APP_SUBTITLE=Institutional Market Intelligence Terminal
VITE_API_BASE=/api
VITE_DEFAULT_ASSET=XAUUSD
VITE_DEFAULT_REGION=global

# Frontend AI mode flags
VITE_OPENROUTER_ENABLED=false
VITE_OLLAMA_ENABLED=false

# Optional browser-visible Ollama config for later desktop/private mode
VITE_OLLAMA_API_URL=http://127.0.0.1:11434
VITE_OLLAMA_MODELS=deepseek-r1-distill-llama-70b,llama-3.1-70b-instruct,qwen2.5-instruct,phi-4

# Server-side provider keys used by Vercel functions
# Recommended for useful web deployment, but not strictly required for the app to boot
FINNHUB_API_KEY=
FRED_API_KEY=
WTO_API_KEY=
TRADINGECONOMICS_API_KEY=
TWELVEDATA_API_KEY=
TDA_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct
OPENROUTER_VISION_MODEL=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=
# Reserved for future direct JB-News / JBlanked connector work.
# Current Vaultum news intelligence does not require it.
JBLANKED_API_KEY=
JBLANKED_API_URL=
X_API_BEARER_TOKEN=
# Optional override if the official API base changes for your access tier.
X_API_BASE_URL=https://api.twitter.com/2
# Format: handle[:weight[:category]], comma-separated.
# Example:
# X_INTEL_ACCOUNTS=financialjuice:6:macro,unusual_whales:5:headline,DeItaone:5:headline,investingLive_:4:headline
X_INTEL_ACCOUNTS=
X_INTEL_POST_LIMIT=18
# Active polling interval for the X event-intelligence engine and panel refresh loop.
X_INTEL_POLLING_MS=60000

# Shared cross-user cache. Recommended once you want worldmonitor-style
# cache behavior across deploys and serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

OANDA_API_KEY=
OANDA_ACCOUNT_ID=
# Optional override. Defaults to the official practice base URL.
OANDA_API_URL=https://api-fxpractice.oanda.com
FXCM_API_TOKEN=
# Preferred generic relay URL for broker/live stream normalization.
WS_RELAY_URL=
# Optional browser-visible relay URL if the frontend later subscribes directly.
VITE_WS_RELAY_URL=
# Shared secret used between Vaultum and your relay tier.
RELAY_SHARED_SECRET=
# Optional deployment-safe FXCM-specific relay alias.
FXCM_RELAY_URL=

# Relay runtime and synthetic flow sidecar
RELAY_RUNTIME_ENABLED=true
RELAY_HOST=0.0.0.0
RELAY_PORT=8787
RELAY_BINANCE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT
RELAY_PREWARM_ASSETS=EURUSD,GBPUSD,USDJPY,XAUUSD,WTI
RELAY_PREWARM_INTERVAL_MS=30000
RELAY_TRADINGVIEW_UNOFFICIAL=true
TRADINGVIEW_SESSION=
TRADINGVIEW_SIGNATURE=
RELAY_ENABLE_OPTIONAL_SCRAPERS=false
TRADING_ECONOMICS_SCRAPE_URL=
WTO_SCRAPE_URL=

# =========================
# DESKTOP
# =========================
# For future Tauri / local private inference mode
OLLAMA_API_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=deepseek-r1-distill-llama-70b
OLLAMA_VISION_MODEL=

# Optional local operator secret for desktop-only utilities
VAULTUM_LOCAL_SECRET=
LOCAL_OPERATOR_SECRET=

# =========================
# RELAY / OPTIONAL
# =========================
# Only needed later if you add a private relay/service tier
ADMIN_SECRET=
